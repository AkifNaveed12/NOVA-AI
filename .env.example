# NOVA AI — Environment Variables Example
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it is in .gitignore.

# ──────────────────────────────────────────────────────────────────
# Groq API — Get your free key at: https://console.groq.com
# Used by: Module 4 (Groq Brain), Module 10 (Email drafting),
#          Module 21 (Personality banter/roast), Module 20 (fact extraction)
# ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here

# ──────────────────────────────────────────────────────────────────
# OpenWeatherMap — Get free key at: https://openweathermap.org/api
# Free tier: 60 calls/min — more than enough for NOVA
# Used by: Module 5 (Weather Information)
# ──────────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=your_key_here

# ──────────────────────────────────────────────────────────────────
# NASA Open API — Get free key at: https://api.nasa.gov
# DEMO_KEY works for development (30 requests/hour limit)
# Used by: Module 6 (Space & Science News — APOD endpoint)
# ──────────────────────────────────────────────────────────────────
NASA_API_KEY=DEMO_KEY

# ──────────────────────────────────────────────────────────────────
# Gmail SMTP — Use App Password (NOT your real Google password)
# Enable at: Google Account -> Security -> 2-Step Verification -> App Passwords
# Create a new App Password for "Mail" -> copy the 16-character code
# Used by: Module 10 (Email Compose & Send)
# ──────────────────────────────────────────────────────────────────
GMAIL_ADDRESS=your_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ──────────────────────────────────────────────────────────────────
# Optional: Picovoice Porcupine — for offline wake word detection
# Get free access key at: https://picovoice.ai
# If not set, Module 1 falls back to energy-threshold detection
# ──────────────────────────────────────────────────────────────────
PORCUPINE_ACCESS_KEY=your_porcupine_key_here

# ──────────────────────────────────────────────────────────────────
# NOVA App API Secret — To connect the Flutter Companion App
# Used by: FastAPI Server
# ──────────────────────────────────────────────────────────────────
NOVA_API_SECRET=nova-secret-change-this


TAVILY_API_KEY=tvly-your-actual-key-here